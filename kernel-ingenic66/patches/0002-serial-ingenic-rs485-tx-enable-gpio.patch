From: AD5X Open OS
Subject: [PATCH] serial: ingenic: RS-485 transmit enable GPIO

Drive the half-duplex transceiver enable named by the stock AD5X DT
property "ingenic,rs485-tx-enable-gpio" (UART4 to the IFS, PC3) while
transmitting; release it when LSR.TEMT shows the shift register empty,
polled from an hrtimer. Without it the IFS never gets to answer.

diff --git a/module_drivers/drivers/tty/serial/ingenic_uart.c b/module_drivers/drivers/tty/serial/ingenic_uart.c
index f3f9a8b40..4fa50a061 100644
--- a/module_drivers/drivers/tty/serial/ingenic_uart.c
+++ b/module_drivers/drivers/tty/serial/ingenic_uart.c
@@ -45,6 +45,8 @@
 #include <linux/of.h>
 #include <linux/of_device.h>
 #include <linux/of_gpio.h>
+#include <linux/gpio/consumer.h>
+#include <linux/hrtimer.h>
 #include <linux/dmaengine.h>
 #include <linux/dma-mapping.h>
 #include <linux/scatterlist.h>
@@ -117,6 +119,11 @@ struct uart_ingenic_port {
 
 	struct uart_pdma_info pdma_info;
 
+	/* half-duplex RS-485 transceiver enable ("ingenic,rs485-tx-enable-gpio") */
+	struct gpio_desc        *rs485_de;
+	struct hrtimer          rs485_timer;
+	bool                    rs485_tx;
+
 #ifdef CONFIG_DEBUG_FS
 	struct dentry   *debugfs;
 #endif
@@ -271,6 +278,51 @@ static void serial_ingenic_enable_ms(struct uart_port *port)
 *Parameter:struct uart_ingenic_port
 *Return:void
 */
+/*
+ * RS-485: drive the transceiver enable while sending and release it once
+ * the last stop bit has left the shift register (LSR.TEMT). THRE only says
+ * the FIFO is empty, so the release is polled from an hrtimer.
+ */
+#define RS485_POLL_NS	(20 * NSEC_PER_USEC)
+
+static void serial_ingenic_rs485_tx_on(struct uart_ingenic_port *up)
+{
+	if (!up->rs485_de || up->rs485_tx)
+		return;
+	hrtimer_try_to_cancel(&up->rs485_timer);
+	gpiod_set_value(up->rs485_de, 1);
+	up->rs485_tx = true;
+}
+
+static void serial_ingenic_rs485_tx_done(struct uart_ingenic_port *up)
+{
+	if (up->rs485_de && up->rs485_tx)
+		hrtimer_start(&up->rs485_timer, ns_to_ktime(RS485_POLL_NS),
+			      HRTIMER_MODE_REL);
+}
+
+static enum hrtimer_restart serial_ingenic_rs485_poll(struct hrtimer *t)
+{
+	struct uart_ingenic_port *up =
+		container_of(t, struct uart_ingenic_port, rs485_timer);
+	enum hrtimer_restart ret = HRTIMER_NORESTART;
+	unsigned long flags;
+
+	spin_lock_irqsave(&up->port.lock, flags);
+	/* THRI set again: a new transmission started, stop_tx re-arms us */
+	if (up->rs485_tx && !(up->ier & UART_IER_THRI)) {
+		if (serial_in(up, UART_LSR) & UART_LSR_TEMT) {
+			gpiod_set_value(up->rs485_de, 0);
+			up->rs485_tx = false;
+		} else {
+			hrtimer_forward_now(t, ns_to_ktime(RS485_POLL_NS));
+			ret = HRTIMER_RESTART;
+		}
+	}
+	spin_unlock_irqrestore(&up->port.lock, flags);
+	return ret;
+}
+
 static void serial_ingenic_stop_tx(struct uart_port *port)
 {
 	struct uart_ingenic_port *up = (struct uart_ingenic_port *)port;
@@ -279,6 +331,7 @@ static void serial_ingenic_stop_tx(struct uart_port *port)
 		up->ier &= ~UART_IER_THRI;// Disable the transmit data request interrupt
 		serial_out(up, UART_IER, up->ier);
 	}
+	serial_ingenic_rs485_tx_done(up);
 }
 
 /*
@@ -743,6 +796,7 @@ static void serial_ingenic_start_tx(struct uart_port *port)
 	struct uart_ingenic_port *up = (struct uart_ingenic_port *)port;
 	int lsr;
 
+	serial_ingenic_rs485_tx_on(up);
 	if (up->use_dma) {
 		lsr = serial_in(up, UART_LSR);
 		check_modem_status(up);
@@ -990,6 +1044,12 @@ static void serial_ingenic_shutdown(struct uart_port *port)
 
 	spin_unlock_irqrestore(&port->lock, flags);
 
+	if (up->rs485_de) {
+		hrtimer_cancel(&up->rs485_timer);
+		gpiod_set_value(up->rs485_de, 0);
+		up->rs485_tx = false;
+	}
+
 	/*
 	 * Wait the RX FIFO to be read.
 	 */
@@ -1598,6 +1658,18 @@ static int serial_ingenic_probe(struct platform_device *pdev)
 		return -ENOMEM;
 	}
 
+	up->rs485_de = devm_gpiod_get_optional(&pdev->dev,
+					       "ingenic,rs485-tx-enable",
+					       GPIOD_OUT_LOW);
+	if (IS_ERR(up->rs485_de)) {
+		return PTR_ERR(up->rs485_de);
+	}
+	hrtimer_init(&up->rs485_timer, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+	up->rs485_timer.function = serial_ingenic_rs485_poll;
+	if (up->rs485_de) {
+		dev_info(&pdev->dev, "%s: RS-485 transmit enable on GPIO\n", up->name);
+	}
+
 	if (up->use_dma) {
 		up->buf_id = 0;
 
