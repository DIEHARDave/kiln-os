#!/bin/sh
#
# Run the mdev daemon (Buildroot's script), except in USB test mode: there
# stock's own mdev daemon already handles /dev, which we share, so only the
# board UARTs get the group our klipper user needs (see /etc/mdev.conf).
#

DAEMON="mdev"
PIDFILE="/var/run/$DAEMON.pid"


start() {
	if [ -n "$AD5X_USB" ]; then
		echo "mdev: stock's runs (USB test mode); ttyS* to group dialout"
		chgrp dialout /dev/ttyS[0-9]*
		chmod 660 /dev/ttyS[0-9]*
		return 0
	fi
	echo -n "Starting $DAEMON... "
	start-stop-daemon -S -b -m -p $PIDFILE -x /sbin/mdev -- -df
	[ $? -eq 0 ] && echo "OK" || echo "ERROR"

	# coldplug modules
	# (The stock kernel's drivers are loaded by S06ad5x-modules; this image
	# has no /lib/modules, so modprobe finds nothing: don't fail on it.)
	find /sys/ -name modalias -print0 | \
		xargs -0 sort -u | \
		tr '\n' '\0' | \
		xargs -0 modprobe -abq 2>/dev/null
	return 0
}

stop() {
	[ -n "$AD5X_USB" ] && return 0
	echo -n "Stopping $DAEMON... "
	start-stop-daemon -K -p $PIDFILE
	[ $? -eq 0 ] && echo "OK" || echo "ERROR"
}

restart() {
	stop
	start
}

case "$1" in
  start|stop|restart)
	"$1"
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
