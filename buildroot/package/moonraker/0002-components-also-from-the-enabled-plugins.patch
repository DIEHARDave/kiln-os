components: also from the enabled Kiln OS plugins

Plugins on the AD5X live outside the read-only image; S62moonraker
passes their component and Python library directories in the
environment.

Upstream: not submitted (AD5X open OS)

--- a/moonraker/components/__init__.py
+++ b/moonraker/components/__init__.py
@@ -4,3 +4,18 @@
 # Copyright (C) 2020 Eric Callahan <arksine.code@gmail.com>
 #
 # This file may be distributed under the terms of the GNU GPLv3 license.
+
+# AD5X: components and Python libraries of the enabled Kiln OS plugins
+# (docs/plugin-api.md, plugin API 1.3). S62moonraker sets
+# AD5X_MOONRAKER_COMPONENTS to their moonraker/components directories and
+# AD5X_PLUGIN_PYTHON to their python directories (colon-separated). The
+# libraries come after Moonraker's own, so a plugin can't replace them.
+import os as _os
+import sys as _sys
+
+for _d in _os.environ.get("AD5X_MOONRAKER_COMPONENTS", "").split(":"):
+    if _d and _os.path.isdir(_d) and _d not in __path__:
+        __path__.append(_d)
+for _d in _os.environ.get("AD5X_PLUGIN_PYTHON", "").split(":"):
+    if _d and _os.path.isdir(_d) and _d not in _sys.path:
+        _sys.path.append(_d)
