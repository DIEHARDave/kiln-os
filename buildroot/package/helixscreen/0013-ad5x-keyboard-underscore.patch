diff --git a/tests/unit/test_keyboard_layout_provider.cpp b/tests/unit/test_keyboard_layout_provider.cpp
--- a/tests/unit/test_keyboard_layout_provider.cpp
+++ b/tests/unit/test_keyboard_layout_provider.cpp
@@ -751,3 +751,23 @@
         REQUIRE(all_found);
     }
 }
+
+TEST_CASE("Keyboard Layout: Numbers and symbols - one period and an underscore",
+          "[ui][layout][numbers]") {
+    const char* const* map = keyboard_layout_get_map(KEYBOARD_LAYOUT_NUMBERS_SYMBOLS, false);
+    REQUIRE(map != nullptr);
+
+    // The period appeared twice on this page; the second one is the underscore
+    int periods = 0;
+    int underscores = 0;
+    for (size_t i = 0; map[i][0] != '\0'; i++) {
+        if (strcmp(map[i], ".") == 0) {
+            periods++;
+        }
+        if (strcmp(map[i], "_") == 0) {
+            underscores++;
+        }
+    }
+    REQUIRE(periods == 1);
+    REQUIRE(underscores == 1);
+}
