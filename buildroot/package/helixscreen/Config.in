config BR2_PACKAGE_HELIXSCREEN
	bool "helixscreen"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8 # C++17, std::filesystem
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_ZLIB
	help
	  HelixScreen, an LVGL touch screen UI for Klipper/Moonraker,
	  built from source for the panel's framebuffer (fbdev) and
	  evdev touch. In /usr/lib/helixscreen; started by
	  S70helixscreen when /data/ad5x/helixscreen.enable exists.

	  https://github.com/prestonbrown/helixscreen
