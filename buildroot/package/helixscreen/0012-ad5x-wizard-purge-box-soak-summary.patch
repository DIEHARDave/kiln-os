+
+/// user_data: "x:-1", "y:0.1" (mm), or "reset"
+static void on_ad5x_trash_move(lv_event_t* e) {
+    LVGL_SAFE_EVENT_CB_BEGIN("[AD5X setup] on_trash_move");
+    const char* arg = static_cast<const char*>(lv_event_get_user_data(e));
+    if (arg && std::strcmp(arg, "reset") == 0) {
+        model().trash_move(0., 0., true);
+    } else if (arg && std::strlen(arg) > 2 && arg[1] == ':') {
+        const double mm = std::strtod(arg + 2, nullptr);
+        model().trash_move(arg[0] == 'x' ? mm : 0., arg[0] == 'y' ? mm : 0., false);
+    }
+    LVGL_SAFE_EVENT_CB_END();
+}
