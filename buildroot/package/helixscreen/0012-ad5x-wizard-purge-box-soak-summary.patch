+void Ad5xSetupModel::trash_move(double dx, double dy, bool reset) {
+    IMoonrakerAPI* api = get_moonraker_api();
+    if (!api) {
+        return;
+    }
+    const std::string cmd = reset ? std::string("TRASH_OFFSET RESET=1 MOVE=1")
+                                  : fmt::format("TRASH_OFFSET DX={:.2f} DY={:.2f} MOVE=1", dx, dy);
+    spdlog::info("[AD5X setup] {}", cmd);
+    const auto token = lifetime_.token();
+    api->execute_gcode(
+        cmd,
+        [this, token]() {
+            token.defer("Ad5xSetupModel::trash_done", [this]() {
+                query_status();
+                refresh();
+            });
+        },
+        [this, token](const MoonrakerError& err) {
+            const std::string message = err.message;
+            token.defer("Ad5xSetupModel::trash_error", [this, message]() {
+                NOTIFY_WARNING("{}", message);
+                query_status();
+                refresh();
+            });
+        },
+        IMoonrakerAPI::kMacroTimeoutMs, /*silent=*/false, /*on_queued=*/nullptr,
+        /*caller_surfaces_errors=*/true);
 }
 
