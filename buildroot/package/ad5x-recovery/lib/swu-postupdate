#!/bin/sh
# SWUpdate post-update command (swupdate -p): "Restart" on the web page or
# swupdate-client -r after a successful install. The .swu's own script has
# already pointed the boot flag at slot B; reboot into it.
echo "$(date) postupdate: rebooting" >> /run/ad5x/swupdate.log
( sleep 2; sync; reboot ) >/dev/null 2>&1 &
exit 0
