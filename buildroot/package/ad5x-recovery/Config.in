config BR2_PACKAGE_AD5X_RECOVERY
	bool "ad5x-recovery"
	depends on BR2_INIT_BUSYBOX
	depends on BR2_PACKAGE_SWUPDATE
	select BR2_PACKAGE_DROPBEAR
	# unsquashfs: vendor files from the saved stock root (ad5x-vendor)
	select BR2_PACKAGE_SQUASHFS
	select BR2_PACKAGE_SQUASHFS_LZO
	help
	  AD5X recovery/update OS (slot A): the printer's own drivers and board
	  heartbeat, network, SSH, SWUpdate (signed .swu into slot B),
	  backup/restore tools and the USB rescue hook.
	  See docs/recovery-os.md.
