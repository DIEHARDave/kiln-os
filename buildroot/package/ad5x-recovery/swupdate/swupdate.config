#
# SWUpdate for the AD5X recovery OS (docs/recovery-os.md). Options not
# listed take SWUpdate's defaults (Buildroot runs olddefconfig).
#
# - Open by default: unsigned .swu accepted; every artifact still carries a
#   sha256 that SWUpdate checks (HASH_VERIFY), and our post-install script
#   verifies the written slot before the boot flag changes. For signed
#   updates (RSA, /etc/swupdate/public.pem) use swupdate-signed.config, see
#   docs/recovery-os.md.
# - Handlers: raw (rootfs2/kernel2 partitions) and shell scripts (our
#   post-install check that flips the boot flag).
# - Hardware check: sw-description "hardware-compatibility" against
#   /etc/hwrevision ("ad5x 1.0").
# - Embedded web server (mongoose) for uploads, the progress socket for UIs.
#
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_DEFAULT_CONFIG_FILE="/etc/swupdate.cfg"
CONFIG_SCRIPTS=y
CONFIG_HW_COMPATIBILITY=y
CONFIG_HW_COMPATIBILITY_FILE="/etc/hwrevision"
CONFIG_SW_VERSIONS_FILE="/etc/sw-versions"
CONFIG_SOCKET_CTRL_PATH="/tmp/sockinstctrl"
CONFIG_SOCKET_PROGRESS_PATH="/tmp/swupdateprog"
CONFIG_SOCKET_REMOTE_HANDLER_DIRECTORY="/tmp/"
# CONFIG_MTD is not set
# CONFIG_LUA is not set
CONFIG_CROSS_COMPILE=""
CONFIG_SYSROOT=""
CONFIG_EXTRA_CFLAGS=""
CONFIG_EXTRA_LDFLAGS=""
CONFIG_EXTRA_LDLIBS=""
CONFIG_BOOTLOADER_NONE=y
CONFIG_SSL_IMPL_MBEDTLS=y
CONFIG_HASH_VERIFY=y
# CONFIG_SIGNED_IMAGES is not set
# CONFIG_ENCRYPTED_IMAGES is not set
CONFIG_WEBSERVER=y
CONFIG_MONGOOSE=y
CONFIG_MONGOOSEIPV6=y
# CONFIG_MONGOOSESSL is not set
CONFIG_LIBCONFIG=y
CONFIG_PARSERROOT=""
CONFIG_RAW=y
CONFIG_SHELLSCRIPTHANDLER=y
# CONFIG_ARCHIVE is not set
# CONFIG_DISKPART is not set
# CONFIG_DISKFORMAT_HANDLER is not set
# CONFIG_BOOTLOADERHANDLER is not set
# CONFIG_SURICATTA is not set
# CONFIG_DOWNLOAD is not set
