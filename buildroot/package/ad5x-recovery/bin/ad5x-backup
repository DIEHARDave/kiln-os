#!/bin/sh
# Raw backup of the eMMC partitions, by GPT name, with sha256s and a manifest.
#
# usage: ad5x-backup [--all] [--no-boot] [--parts "NAME..."] [--dry-run] [DEST]
#   DEST       directory to create the backup in (a USB stick's mount point,
#              or any directory not on /data). Default: the first USB stick
#              (mounted with ad5x-usb mount).
#   --all      also userdata (5.8 GB; /data is made read-only while copying)
#   --no-boot  leave out the first MiB of the disk (GPT, SPL, U-Boot)
#   --parts    exactly these names (kernel rootfs kernel2 rootfs2 ota
#              usershare userdata boot)
#   --dry-run  print the plan and the space check, write nothing
#
# Creates DEST/ad5x-backup-<date>-<n>/ with NAME.img per partition
# (NAME.img.000, .001... in 1 GiB pieces when DEST is FAT and the image is
# 4 GiB or more), SHA256SUMS (sha256 of each whole image, "NAME.img"),
# MANIFEST.txt (device, start sector, size, slot contents, boot flag).
# Each image is read back from DEST and checked. Last line on success:
#   backup: OK <directory>
# Exit status 0 on success. Restore with ad5x-restore.
. /usr/lib/ad5x-recovery/recovery.sh

all= noboot= parts= dry=
while [ $# -gt 0 ]; do
	case "$1" in
	--all) all=1 ;;
	--no-boot) noboot=1 ;;
	--parts) parts=$2; shift ;;
	--dry-run) dry=1 ;;
	-h|--help) sed -n '2,23p' "$0"; exit 0 ;;
	-*) sed -n '2,23p' "$0" >&2; exit 2 ;;
	*) break ;;
	esac
	shift
done
DEST=$1

if [ -z "$parts" ]; then
	parts="kernel rootfs kernel2 rootfs2 ota usershare"
	[ -n "$all" ] && parts="$parts userdata"
	[ -n "$noboot" ] || parts="boot $parts"
fi
if [ -z "$DEST" ]; then
	[ -n "$dry" ] || ad5x-usb mount 5 >/dev/null
	DEST=$(rc_usb_mounts | head -1)
	[ -n "$DEST" ] || rc_die "no DEST and no USB stick mounted"
fi
[ -d "$DEST" ] || rc_die "no directory $DEST"
DEST=$(readlink -f "$DEST")
case " $parts " in *" userdata "*)
	case "$DEST/" in "$AD5X_DATA"/*) rc_die "can't back up userdata into $DEST (on userdata itself)" ;; esac ;;
esac
fs=$(df -PT "$DEST" 2>/dev/null | awk 'NR == 2 { print $2 }')
[ -n "$fs" ] || fs=$(awk -v d="$DEST" 'index(d "/", $2 "/") == 1 { f = $3 } END { print f }' "$AD5X_MOUNTS")

# Plan and space check
total=0
for n in $parts; do
	dev=$(rc_dev $n) || rc_die "no partition '$n'"
	b=$(rc_bytes $n) || rc_die "no size for '$n'"
	total=$((total + b))
	printf 'plan: %-9s %-22s %12s bytes\n' "$n" "$dev" "$b"
done
free=$(df -Pk "$DEST" | awk 'NR == 2 { print $4 }')
echo "plan: total $((total / 1048576)) MiB to $DEST (${fs:-?}, $((free / 1024)) MiB free)"
[ $((total / 1024 + 1024)) -le "$free" ] || rc_die "not enough space on $DEST"
[ -n "$dry" ] && { echo "backup: dry run, nothing written"; exit 0; }

stamp=$(date +%Y%m%d-%H%M%S)
i=1; while [ -e "$DEST/ad5x-backup-$stamp-$i" ]; do i=$((i + 1)); done
OUT=$DEST/ad5x-backup-$stamp-$i
mkdir -p "$OUT" || rc_die "can't create $OUT"
M=$OUT/MANIFEST.txt
{
	echo "AD5X eMMC backup (ad5x-backup), $(date)"
	echo "made by: $(cat /etc/ad5x-release 2>/dev/null)"
	echo "running root: $(rc_root), slot $(rc_slot)"
	echo "boot flag: $(rc_read_flag)"
	echo "disk: $(rc_disk)"
	echo "slot A holds: $(rc_slot_holds rootfs)"
	echo "slot B holds: $(rc_slot_holds rootfs2)"
	echo "# name device start_sector bytes sha256 files"
} > "$M"
: > "$OUT/SHA256SUMS"

ro_data=
case " $parts " in *" userdata "*)
	if rc_mounted "$(rc_part userdata)"; then
		if mount -o remount,ro "$AD5X_DATA" 2>/dev/null; then
			ro_data=1; echo "backup: $AD5X_DATA read-only while copying"
		else
			echo "backup: WARNING $AD5X_DATA busy, userdata copied while mounted read-write" | tee -a "$M"
		fi
	fi ;;
esac
restore_data() { [ -n "$ro_data" ] && mount -o remount,rw "$AD5X_DATA"; ro_data=; }
trap restore_data EXIT

CHUNK=1024	# MiB per piece on FAT
for n in $parts; do
	dev=$(rc_dev $n); b=$(rc_bytes $n)
	start=0; [ "$n" = boot ] || start=$(rc_part_start $n)
	echo "backup: $n ($dev, $b bytes)"
	if [ "$fs" = vfat ] && [ "$b" -ge 4294967296 ]; then
		sha=$(rc_sha "$dev" "$b")
		k=0 files=
		while [ $((k * CHUNK * 1048576)) -lt "$b" ]; do
			f=$(printf '%s.img.%03d' $n $k)
			dd if="$dev" of="$OUT/$f" bs=1M skip=$((k * CHUNK)) count=$CHUNK 2>/dev/null ||
				rc_die "copy of $n failed"
			files="$files $f"; k=$((k + 1))
		done
		sync
		rc_drop_caches
		got=$(cd "$OUT" && cat $files | head -c "$b" | sha256sum | cut -d' ' -f1)
	else
		sha=$(head -c "$b" "$dev" | tee "$OUT/$n.img" | sha256sum | cut -d' ' -f1)
		files=" $n.img"
		sync
		rc_drop_caches
		got=$(rc_sha "$OUT/$n.img" "$b")
		[ "$(rc_fsize "$OUT/$n.img")" = "$b" ] || got=short
	fi
	[ "$got" = "$sha" ] || rc_die "$n: copy on $DEST reads back $got, source $sha"
	echo "$sha  $n.img" >> "$OUT/SHA256SUMS"
	echo "$n $dev $start $b $sha$files" >> "$M"
	echo "backup: $n OK $sha"
done
restore_data
sync
echo "backup: OK $OUT"
