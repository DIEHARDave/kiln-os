#!/bin/sh
# Leave recovery: point the boot flag at slot B (the main OS) and reboot.
#
# usage: ad5x-boot-main [--no-reboot] [--force]
#   --no-reboot  only set the flag (the next power-cycle or reboot runs B)
#   --force      skip the check that slot B holds a system
#
# The check: rootfs2 is a squashfs with /linuxrc (our main OS or stock)
# and kernel2 starts with a uImage header. The main OS's try-once points
# the flag back here if its start-up doesn't finish.
. /usr/lib/ad5x-recovery/recovery.sh
noreboot= force=
for a in "$@"; do
	case "$a" in
	--no-reboot) noreboot=1 ;;
	--force) force=1 ;;
	-h|--help) sed -n '2,11p' "$0"; exit 0 ;;
	*) sed -n '2,11p' "$0" >&2; exit 2 ;;
	esac
done
if [ -z "$force" ]; then
	k=$(rc_part kernel2) && rc_uimage_len "$k" >/dev/null ||
		rc_die "kernel2 holds no uImage (use --force to boot it anyway)"
	holds=$(rc_slot_holds rootfs2)
	case "$holds" in
	ad5x*|stock|recovery*) ;;
	*) rc_die "slot B holds '$holds' (use --force to boot it anyway)" ;;
	esac
	echo "boot-main: slot B holds $holds"
fi
rc_set_flag B || rc_die "setting the boot flag failed"
echo "boot-main: boot flag $(rc_read_flag)"
[ -n "$noreboot" ] && exit 0
echo "boot-main: rebooting"
sync; reboot
