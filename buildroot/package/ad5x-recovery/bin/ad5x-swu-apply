#!/bin/sh
# Install a .swu or .zip update (main OS into slot B) with SWUpdate.
#
# usage: ad5x-swu-apply [--check] [--reboot] FILE.swu|FILE.zip
#   A .zip (tools/make_swu.sh --zip) is turned into a .swu first
#   (ad5x-zip-to-swu: SHA256SUMS checked).
#   --check   verify only: signature (if signed), sw-description, hardware
#             compatibility, sha256 of every artifact; nothing is written
#   --reboot  reboot into the main OS after a successful install
#
# Goes through the running SWUpdate daemon (S70swupdate) when its control
# socket exists, so progress shows on /tmp/swupdateprog (UI, web page);
# otherwise runs swupdate itself. The .swu's script checks the written slot
# and points the boot flag at slot B. Exit status 0 on success; the last
# line is "swu-apply: OK", "swu-apply: CHECK OK" or "swu-apply: FAILED ...".
KEY=/etc/swupdate/public.pem
check= reboot_after=
while [ $# -gt 0 ]; do
	case "$1" in
	--check) check=1 ;;
	--reboot) reboot_after=1 ;;
	-h|--help) sed -n '2,17p' "$0"; exit 0 ;;
	-*) sed -n '2,17p' "$0" >&2; exit 2 ;;
	*) break ;;
	esac
	shift
done
[ $# -eq 1 ] || { sed -n '2,17p' "$0" >&2; exit 2; }
SWU=$1
[ -f "$SWU" ] || { echo "swu-apply: FAILED no file $SWU"; exit 1; }
if [ "$(head -c 4 "$SWU" | od -An -t x1 | tr -d ' \n')" = 504b0304 ]; then
	TMPSWU=${AD5X_DATA:-/data}/ad5x/update/.from-zip.swu
	trap 'rm -f "$TMPSWU"' EXIT
	echo "swu-apply: $SWU is a zip, converting"
	ad5x-zip-to-swu "$SWU" "$TMPSWU" || { echo "swu-apply: FAILED zip"; exit 1; }
	SWU=$TMPSWU
fi
# Open mode: no key, unsigned .swu (sha256 per artifact). Signed builds
# carry the key and pass it on.
KEYARG=
[ -f "$KEY" ] && KEYARG="-k $KEY"
echo "swu-apply: $SWU ($(wc -c < "$SWU" | tr -d ' ') bytes)"

if [ -n "$check" ]; then
	# -c: check the image only (runs no scripts, writes nothing)
	if swupdate -c $KEYARG -i "$SWU"; then
		echo "swu-apply: CHECK OK"; exit 0
	fi
	echo "swu-apply: FAILED check"; exit 1
fi

if [ -S /tmp/sockinstctrl ] && pidof swupdate >/dev/null; then
	swupdate-client -v "$SWU"; rc=$?
else
	swupdate -v $KEYARG -i "$SWU"; rc=$?
fi
if [ $rc -ne 0 ]; then
	echo "swu-apply: FAILED (swupdate exit $rc); boot flag unchanged"
	exit 1
fi
echo "swu-apply: OK"
if [ -n "$reboot_after" ]; then
	sync; reboot
fi
exit 0
