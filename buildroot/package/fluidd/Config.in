config BR2_PACKAGE_FLUIDD
	bool "fluidd"
	depends on BR2_USE_MMU # nginx
	select BR2_PACKAGE_NGINX
	select BR2_PACKAGE_NGINX_HTTP
	select BR2_PACKAGE_NGINX_HTTP_PROXY_MODULE
	select BR2_PACKAGE_NGINX_HTTP_MAP_MODULE
	select BR2_PACKAGE_NGINX_HTTP_GZIP_STATIC_MODULE
	help
	  Fluidd, the web front end for Klipper/Moonraker: the prebuilt
	  release, in /usr/share/fluidd, served by nginx on port 80
	  (/etc/nginx/nginx.conf, S63nginx) with Moonraker proxied.

	  https://github.com/fluidd-core/fluidd
